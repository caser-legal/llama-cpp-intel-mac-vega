diff --git a/agent/agent_init.py b/agent/agent_init.py
index bd9b947..30d6769 100644
--- a/agent/agent_init.py
+++ b/agent/agent_init.py
@@ -1300,6 +1300,27 @@ def _init_memory(agent, _agent_cfg, skip_memory, platform):
     inject_memory_provider_tools(agent)
 
 
+def _compact_tool_definitions(tools):
+    def compact(value, property_map=False):
+        if isinstance(value, dict):
+            return {
+                key: item if key in ("enum", "const", "default", "examples") else compact(
+                    item, key in ("properties", "patternProperties", "$defs", "definitions", "dependentSchemas"))
+                for key, item in value.items() if property_map or key != "description"
+            }
+        if isinstance(value, list):
+            return [compact(item) for item in value]
+        return value
+    result = []
+    for tool in tools:
+        item = compact(tool)
+        description = tool.get("function", {}).get("description", "")
+        if "function" in item and description:
+            item["function"]["description"] = description.split("\n")[0].split(". ")[0][:160]
+        result.append(item)
+    return result
+
+
 def _apply_agent_section(agent, _agent_cfg):
     # Skills config: nudge interval for skill creation reminders
     agent._skill_nudge_interval = 10
@@ -1307,6 +1328,9 @@ def _apply_agent_section(agent, _agent_cfg):
         agent._skill_nudge_interval = int(_agent_cfg.get("skills", {}).get("creation_nudge_interval", 10))
 
     _agent_section = _cfg_dict(_agent_cfg, "agent")
+    agent._base_system_prompt = _agent_section.get("base_system_prompt")
+    if _agent_section.get("compact_tool_descriptions"):
+        agent.tools = _compact_tool_definitions(agent.tools)
     agent.budget_warning_ratio = normalize_budget_warning_ratio(
         _agent_section.get("budget_warning_ratio")
     )
